# ------------------------------------------------------------------
# Client environment template — copy to .env.local
# Only NEXT_PUBLIC_* values are exposed to the browser.
# ------------------------------------------------------------------

# MongoDB Atlas connection string used by BetterAuth MongoDB adapter.
MONGODB_URI=

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Client origin. Must match Vercel URL in production.
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_CLIENT_URL=http://localhost:3000

# Express API base URL. Must include /api.
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Google OAuth credentials (server-side only in BetterAuth config).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Stripe publishable key (safe for browser; optional for hosted Checkout).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
